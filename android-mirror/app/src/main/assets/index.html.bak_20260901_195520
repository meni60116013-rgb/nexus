<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#050709"><title>V-CORE NEXUS // PC Enterprise</title><style>
:root{--bg:#050709;--panel:#0a1016;--line:#123742;--cyan:#00eaff;--green:#00ff9d;--amber:#ffb020;--danger:#ff3b5c;--text:#d8f3f7;--muted:#587480}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 50% 0%,#00343b33,transparent 55%),var(--bg);color:var(--text);font:14px system-ui, sans-serif}header{padding:18px 24px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}h1{margin:0;color:var(--cyan);font-size:20px}nav{display:flex;gap:6px;flex-wrap:wrap;padding:12px 24px;border-bottom:1px solid var(--line);background:#0d151c}button{background:#07141a;color:var(--cyan);border:1px solid var(--line);padding:10px 14px;border-radius:6px;cursor:pointer}button.active,button:hover{border-color:var(--cyan)}main{max-width:1200px;margin:auto;padding:24px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px}.card{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:18px}.card h2{margin-top:0;color:var(--cyan);font-size:15px}label{display:block;color:var(--muted);margin:10px 0 5px}input,select,textarea{width:100%;background:#03070a;color:var(--text);border:1px solid var(--line);padding:10px;border-radius:5px}.out{margin-top:12px;padding:12px;background:#03070a;border-left:2px solid var(--cyan);min-height:24px;white-space:pre-wrap}.muted{color:var(--muted)}.ok{color:var(--green)}.warn{color:var(--amber)}.bad{color:var(--danger)}.toolbar{display:flex;gap:8px;align-items:center}.toolbar input{max-width:520px}.screen{display:none}.screen.active{display:block}</style></head><body><header><h1>V-CORE NEXUS // MOBILE WORKSHOP</h1><div id="status" class="muted">NUBE: no configurada</div></header><nav><button class="active" data-screen="dashboard">Dashboard</button><button data-screen="engineering">Ingeniería</button><button data-screen="workshop">Taller / ERP</button><button data-screen="diagnostics">Diagnóstico</button><button data-screen="fleet">Flotas</button><button data-screen="analytics">Analytics</button><button data-screen="twin">Digital Twin</button><button data-screen="cad">CAD</button></nav><main>
<section id="dashboard" class="screen active"><div class="toolbar"><input id="api" placeholder="https://tu-worker.workers.dev"><button onclick="connect()">CONECTAR</button></div><div class="grid" style="margin-top:16px"><div class="card"><h2>Núcleo</h2><p>Esta interfaz no ejecuta motores de negocio. Solo envía entradas y representa respuestas del VCORE Cloud.</p></div><div class="card"><h2>Estado</h2><div id="health" class="out">Sin consultar</div></div></div></section>
<section id="engineering" class="screen"><div class="grid"><div class="card"><h2>Chasis</h2><label>Fuerza N</label><input id="cf" value="2500"><label>Longitud mm</label><input id="cl" value="600"><label>Diámetro mm</label><input id="cd" value="31.75"><label>Espesor mm</label><input id="ct" value="2"><label>Material</label><select id="cm"><option value="cromoly_4130">4130 Cromoly</option><option value="acero_1020">Acero 1020</option><option value="dom_1026">DOM 1026</option></select><button onclick="call('/api/v1/engineering/chassis',{fuerzaN:+cf.value,longitudMm:+cl.value,diametroExtMm:+cd.value,espesorParedMm:+ct.value,material:cm.value},'co')">ANALIZAR</button><div id="co" class="out"></div></div><div class="card"><h2>Transmisión</h2><label>Piñón</label><input id="tp" value="15"><label>Corona</label><input id="tc" value="38"><label>RPM</label><input id="tr" value="7500"><label>Radio rueda mm</label><input id="tw" value="300"><button onclick="call('/api/v1/engineering/transmission',{dientesPinon:+tp.value,dientesCorona:+tc.value,rpmMotor:+tr.value,radioRuedaMm:+tw.value},'to')">CALCULAR</button><div id="to" class="out"></div></div><div class="card"><h2>Enfriamiento</h2><label>HP</label><input id="eh" value="15"><label>Ambiente °C</label><input id="et" value="30"><button onclick="call('/api/v1/engineering/cooling',{potenciaHp:+eh.value,tempAmbienteC:+et.value},'eo')">CALCULAR</button><div id="eo" class="out"></div></div></div></section>
<section id="workshop" class="screen"><div class="card"><h2>Cotización ERP</h2><label>Metros de tubo</label><input id="wm" value="6"><label>Horas de soldadura</label><input id="wh" value="8"><button onclick="call('/api/v1/workshop/quote',{metrosTubo:+wm.value,horasSoldadura:+wh.value},'wo')">CALCULAR</button><div id="wo" class="out"></div></div></section>
<section id="diagnostics" class="screen"><div class="grid"><div class="card"><h2>Diagnóstico</h2><label>Temperatura °C</label><input id="dt" value="90"><label>Presión aceite PSI</label><input id="dp" value="40"><button onclick="call('/api/v1/diagnostics/evaluate',{temperaturaC:+dt.value,presionOilPsi:+dp.value,vibracionAnormal:false,alertaSOS:false},'do')">EVALUAR</button><div id="do" class="out"></div></div><div class="card"><h2>DTC</h2><label>Código</label><input id="dc" value="P0300"><button onclick="call('/api/v1/diagnostics/dtc',{codigo:dc.value},'dto')">INTERPRETAR</button><div id="dto" class="out"></div></div></div></section>
<section id="fleet" class="screen"><div class="card"><h2>Flotas</h2><button onclick="get('/api/v1/fleet/kpis','fo')">ACTUALIZAR KPI</button><div id="fo" class="out"></div></div></section>
<section id="analytics" class="screen"><div class="card"><h2>Analytics</h2><p class="muted">El cliente no calcula KPI. Envía datasets y representa el resumen devuelto por el núcleo.</p><textarea id="adata" rows="7">{"workOrders":[],"telemetry":[],"invoices":[]}</textarea><button onclick="call('/api/v1/analytics/summary',JSON.parse(adata.value),'ao')">ANALIZAR</button><div id="ao" class="out"></div></div></section>
<section id="twin" class="screen"><div class="card"><h2>Digital Twin</h2><textarea id="tdata" rows="8">{"vehicleId":"DEMO-001","components":[{"id":"engine","type":"engine"}]}</textarea><button onclick="call('/api/v1/digital-twin/manifest',JSON.parse(tdata.value),'twinout')">GENERAR MANIFIESTO</button><div id="twinout" class="out"></div></div></section>
<section id="cad" class="screen"><div class="card"><h2>CAD / DXF</h2><p>El núcleo genera el archivo. El espejo solo solicita y descarga.</p><a id="dxf" href="#" target="_blank"><button>ABRIR DXF DEL NÚCLEO</button></a></div></section>
</main><script>let API=localStorage.getItem('vcore_api')||'';api.value=API;function base(){return API.replace(/\/$/,'')}function connect(){API=api.value.trim();localStorage.setItem('vcore_api',API);dxf.href=base()+'/api/v1/cad/dxf';health.textContent='consultando…';get('/api/v1/health','health')}async function get(p,id){try{const r=await fetch(base()+p);const j=await r.json();document.getElementById(id).textContent=JSON.stringify(j,null,2);status.textContent='NUBE: conectada'}catch(e){document.getElementById(id).textContent='Sin conexión con el núcleo';status.textContent='NUBE: sin respuesta'}}async function call(p,b,id){const o=document.getElementById(id);o.textContent='Procesando en VCORE Cloud…';try{const r=await fetch(base()+p,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)});const j=await r.json();o.textContent=JSON.stringify(j,null,2)}catch(e){o.textContent='Error de conexión con el núcleo'}}document.querySelectorAll('nav button').forEach(b=>b.onclick=()=>{document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));document.getElementById(b.dataset.screen).classList.add('active');document.querySelectorAll('nav button').forEach(x=>x.classList.remove('active'));b.classList.add('active')});if(API)connect();</script></body></html>
